            "has_integrals": false,
            "has_derivatives": false,
            "has_vectors": false,
            "has_matrices": false
          },
          "required_knowledge": ["algebra", "basic_calculus", "functions"],
          "answers": {
            "answer_snippet": "4/(5cos²θ - 4) = 5 leading to 25cos²θ = 24, cos θ = ±√(24/25) = ±0.9798. θ = 11.5° or 168.5°",
            "answer_full": "4/(5cos²θ - 4) = 5. Multiply both sides by (5cos²θ - 4): 4 = 5(5cos²θ - 4). 4 = 25cos²θ - 20. 25cos²θ = 24. cos²θ = 24/25. cos θ = ±√(24/25) = ±(2√6/5) = ±0.9798. For 0° < θ < 180°: θ = arccos(0.9798) = 11.5° or θ = 180° - 11.5° = 168.5°"
          }
        }
