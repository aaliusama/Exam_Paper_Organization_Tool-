          "syllabus_outcomes": ["1.4"],
          "answers": {
            "answer_snippet": "Area of triangle = ½ × 5 × 12 = 30. Area of sectors = ½ × 5² × 1.176 + ½ × 8² × 0.3948 = 14.70 + 12.63. Area = 30 - 14.70 - 12.63 = 2.67"
