          "syllabus_outcomes": ["1.3"],
          "answers": {
            "answer_snippet": "Substitute y = 3x - 20 into circle equation: (x + 1)² + (3x - 22)² = 85 leading to 10x² - 130x + 400 = 0. Solutions: x = 8 or 5. Points: (8, 4), (5, -5)"
